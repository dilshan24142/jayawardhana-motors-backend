# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000
NODE_ENV=development

# Local PostgreSQL (Docker Compose or your own install)
DATABASE_URL=postgres://jm_app:jm_app_password@localhost:5432/jayawardhana_motors
# Separate database used by automated tests (its data is wiped)
TEST_DATABASE_URL=postgres://jm_app:jm_app_password@localhost:5432/jayawardhana_motors_test

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Firebase Admin SDK (JM-06). Get these from the service account in the Firebase console.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
